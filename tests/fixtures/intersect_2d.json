    {"name": "bspline_ellipse_circle", "note": "the B-spline of an ellipse meets a circle four times", "first": {"shape": {"type": "bspline_of", "of": {"type": "ellipse", "center": [0, 0], "x_dir": [1, 0], "major": 3, "minor": 1, "clockwise": false}}, "trim": null}, "second": {"shape": {"type": "circle", "center": [0, 0], "radius": 2, "clockwise": false}, "trim": null}, "expect": {"method": "numeric", "complete": true, "hits": [{"point": [-1.8371173070873836, -0.7905694150420949], "multiplicity": 1}, {"point": [-1.8371173070873836, 0.7905694150420949], "multiplicity": 1}, {"point": [1.8371173070873836, -0.7905694150420949], "multiplicity": 1}, {"point": [1.8371173070873836, 0.7905694150420949], "multiplicity": 1}], "overlaps": []}},
