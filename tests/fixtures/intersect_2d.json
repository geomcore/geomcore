    {"name": "bspline_trimmed_ellipse", "note": "the half of the B-spline ellipse with y > 0 keeps one hit with the y axis", "first": {"shape": {"type": "polyline", "points": [[0, -3], [0, 3]]}, "trim": null}, "second": {"shape": {"type": "bspline_of", "of": {"type": "ellipse", "center": [0, 0], "x_dir": [1, 0], "major": 3, "minor": 2, "clockwise": false}}, "trim": [0.0, 3.141592653589793]}, "expect": {"method": "numeric", "complete": true, "hits": [{"point": [0, 2], "multiplicity": 1}], "overlaps": []}},
    {"name": "ellipse_coincident_full", "note": "an ellipse with itself overlaps over a full period", "first": {"shape": {"type": "ellipse", "center": [0, 0], "x_dir": [1, 0], "major": 3, "minor": 2, "clockwise": false}, "trim": null}, "second": {"shape": {"type": "ellipse", "center": [0, 0], "x_dir": [1, 0], "major": 3, "minor": 2, "clockwise": false}, "trim": null}, "expect": {"method": "exact", "complete": true, "hits": [], "overlaps": [{"first": [0, 6.283185307179586], "second": [0, 6.283185307179586], "same_direction": true}]}},
