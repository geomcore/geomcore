    {"name": "bspline_miss", "note": "a polyline far from an ellipse", "first": {"shape": {"type": "polyline", "points": [[5, -3], [5, 3]]}, "trim": null}, "second": {"shape": {"type": "ellipse", "center": [0, 0], "x_dir": [1, 0], "major": 3, "minor": 2, "clockwise": false}, "trim": null}, "expect": {"method": "numeric", "complete": true, "hits": [], "overlaps": []}},
